# =============================================================================
# Bushido Discipline OS - Environment Configuration Template
# =============================================================================

# Server Environment Mode ('development' | 'production')
NODE_ENV=

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Required in production: high-entropy secret with at least 32 characters
JWT_SECRET=

# Super Administrator Credentials (Production)
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASS=
SUPER_ADMIN_NAME=
SUPER_ADMIN_IDENTIFIER=

# -----------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL & Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# -----------------------------------------------------------------------------
# Payment Gateway (Zarinpal)
# -----------------------------------------------------------------------------
# Real 36-character Merchant ID for production live transactions
ZARINPAL_MERCHANT_ID=

# -----------------------------------------------------------------------------
# Test Capabilities & Private Staging Flags
# IMPORTANT: In public production, leave these empty or 'false' to fail closed.
# On private Vercel test environment, set ALLOW_TEST_SHORTCUTS=true to enable.
# -----------------------------------------------------------------------------
# Enable test capabilities (quick-login, mock OTP, mock payment simulator) in production
ALLOW_TEST_SHORTCUTS=

# Return OTP code in API response payloads for automated test suites (requires ALLOW_TEST_SHORTCUTS=true)
ENABLE_OTP_DEBUG=

# Enable/disable Quick Login independently (defaults to ALLOW_TEST_SHORTCUTS value)
ENABLE_QUICK_LOGIN=
