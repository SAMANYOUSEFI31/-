# =============================================================================
# Bushido Discipline OS - Environment Configuration (.env.example)
# =============================================================================

# Application Environment: 'development' | 'test' | 'staging' | 'production'
# In production, test shortcuts, quick login, OTP debug, and mock providers are strictly disabled.
APP_ENV=

# Node / Vite runtime mode (optional, defaults derived from runtime or APP_ENV)
# NODE_ENV=production

# Database Connection URLs (PostgreSQL / Supabase / Neon / Liara)
DATABASE_URL=
DIRECT_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# JWT Secret: Required in production and staging (minimum 32 characters)
JWT_SECRET=

# Staging Test Shortcuts: Only effective when APP_ENV=staging (ignored in public production)
ALLOW_TEST_SHORTCUTS=
ENABLE_QUICK_LOGIN=
ENABLE_OTP_DEBUG=

# Super Admin Initial Identity (Required for production admin bootstrap)
SUPER_ADMIN_IDENTIFIER=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASS=
SUPER_ADMIN_NAME=

# Payment Gateway (Future live gateway integration)
ZARINPAL_MERCHANT_ID=