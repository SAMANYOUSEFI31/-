# Bushido Discipline OS - Environment Variables Specification
# Production Safety Boundaries:
# - Production strictly fails closed.
# - Test shortcuts, quick login, mock OTP, and mock payment are impossible in production.
# - Built-in super-admin fallback credentials do not exist in production.
# - JWT_SECRET has no fallback in production and requires at least 32 characters.
# - The build process never mutates the database schema; migrations are deployed only via `npm run db:migrate:deploy`.

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Mandatory in production. Minimum length: 32 characters. No fallback secret exists.
JWT_SECRET=

# ==============================================================================
# Database Configuration
# ==============================================================================
# Connection string for PostgreSQL (e.g. Neon, Supabase, self-hosted).
# If omitted in development/test, a local in-memory/file database fallback is used.
# NOTE: Schema is NEVER mutated during build/vercel-build. Migrations use `db:migrate:deploy`.
DATABASE_URL=
DIRECT_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# ==============================================================================
# Super Admin Credentials
# ==============================================================================
# In production, NO built-in fallback credentials exist. These must be explicitly defined.
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_IDENTIFIER=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASS=

# ==============================================================================
# Non-Production Capabilities (Test, Development & Staging Only)
# ==============================================================================
# These flags are STRICTLY IGNORED and locked in production (Fail-Closed).
# Test shortcuts, quick login, mock OTP, and mock payment are impossible in production.
ALLOW_TEST_SHORTCUTS=false
ENABLE_QUICK_LOGIN=false
ENABLE_OTP_DEBUG=false

# ==============================================================================
# External Payment Gateway
# ==============================================================================
# Merchant ID for payment gateway integration. In production without a configured
# gateway adapter, payment endpoints fail closed (HTTP 503 PAYMENT_UNAVAILABLE).
ZARINPAL_MERCHANT_ID=
