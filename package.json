{
  "name": "bushido-discipline-os",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrations:verify": "tsx scripts/verify-migrations.ts",
    "db:migrations:preflight": "tsx scripts/preflight-existing-database.ts",
    "db:backup:verify": "tsx scripts/backup-verify.ts",
    "db:restore:verify": "tsx scripts/restore-verify.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "vercel-build": "npm run build",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prisma": "6.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
